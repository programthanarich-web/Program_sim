# หลังบ้าน: คัดลอกเป็น .env.local แล้วกรอกค่าจริง
# ค่าที่เป็นความลับทั้งหมดอยู่ฝั่ง server เท่านั้น ห้ามใส่ prefix NEXT_PUBLIC_
# ห้าม commit ไฟล์ .env.local

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ฐาน URL ของหลังบ้าน ใช้สร้างลิงก์ในข้อความ LINE (ไม่ใช่ความลับ)
APP_BASE_URL=http://localhost:3001

# LINE Messaging API (ไม่บังคับ: ถ้าไม่ตั้ง ระบบทำงานโหมดทดสอบ)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_GROUP_ID=

# secret ที่ตัวตั้งเวลาภายนอกใช้เรียก POST /api/notifications/dispatch
NOTIFY_DISPATCH_SECRET=

# การซิงค์เนื้อหาหน้าบ้านผ่าน GitHub (token เก็บฝั่ง server เท่านั้น)
# token ต้องมีสิทธิ์ Contents: read & write เฉพาะ repo นี้เท่านั้น
GITHUB_CONTENT_TOKEN=
GITHUB_CONTENT_REPO=owner/repo
GITHUB_CONTENT_BRANCH=main
GITHUB_CONTENT_PREFIX=apps/storefront
