# หน้าบ้านลูกค้า: คัดลอกเป็น .env.local แล้วกรอกค่าจริง
# ค่าที่เป็นความลับต้องอยู่ใน Vercel (Server) เท่านั้น ห้ามใส่ prefix NEXT_PUBLIC_

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# ใช้เฉพาะฝั่ง server (อัปโหลดสลิป บันทึกเบอร์ สร้างลิงก์ QR) ห้ามให้ browser เห็น
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
