{
  "name": "program-thanarich",
  "version": "0.2.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:storefront": "npm run dev -w @pt/storefront",
    "dev:backoffice": "npm run dev -w @pt/backoffice",
    "build": "npm run build -w @pt/storefront && npm run build -w @pt/backoffice",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "test:db": "bash supabase/tests/run.sh"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
